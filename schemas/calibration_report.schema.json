{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CalibrationReport",
  "type": "object",
  "required": ["schema_version", "generated_at", "pit", "coverage"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "pit": {
      "type": "object",
      "required": ["counts", "bin_edges"],
      "properties": {
        "counts": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "bin_edges": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
